# Add these NON-SECRET settings to your existing .env.
# Replace placeholders with valid model IDs available through your own OpenRouter key.
BOT_MODELS=openrouter/PROVIDER/MODEL_ONE,openrouter/PROVIDER/MODEL_TWO
# Example route only: requires configured AskNews credentials.
BOT_RESEARCHER=asknews/news-summaries
# Set to the tournament you actually entered; do not blindly copy an old SDK season.
BOT_TOURNAMENT_ID=YOUR_TOURNAMENT_SLUG
BOT_ENABLE_REVIEW=true
BOT_DISAGREEMENT=0.20
BOT_CALL_TIMEOUT_SECONDS=120
BOT_QUESTION_BUDGET_SECONDS=600
BOT_MAX_OUTPUT_TOKENS=3000
